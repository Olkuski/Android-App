<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp"
    tools:context=".LogWorkoutActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="16dp">

        <!-- Title Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Your Workout"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- CardView Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFFFFF"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etBodyWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Body Weight (kg)"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textColorHint="#000000"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etBenchPress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bench Press (kg)"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textColorHint="#000000"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etSquat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Squat (kg)"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textColorHint="#000000"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etDeadlift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Deadlift (kg)"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textColorHint="#000000"
                    android:background="@android:color/transparent"
                    android:padding="12dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Save Workout Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveWorkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Workout"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>
